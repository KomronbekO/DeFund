# Backend service config
PORT=4001
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Chain config
CHAIN_RPC_URL=http://127.0.0.1:8545
# Set to 'sepolia' or 'localhost' — selects which deployment file to load
CHAIN_NETWORK=localhost
CONTRACT_ADDRESS=
DEPLOY_BLOCK=0

# Optional Pinata for IPFS uploads (POST /uploads). If unset, files are saved
# to ./uploads/ on disk and served back via the gateway at /files/<id>.
PINATA_JWT=

# Public URL where uploaded files are reachable (used to compose the URL we
# write into the contract). Default points at the gateway.
PUBLIC_BASE_URL=http://localhost:4000
