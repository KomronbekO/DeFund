PORT=4000
NODE_ENV=development

# URL of the upstream backend service
BACKEND_URL=http://127.0.0.1:4001

# CORS — frontend origin allowed
FRONTEND_ORIGIN=http://localhost:3000

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# SIWE auth — if true, /uploads requires a verified SIWE message
REQUIRE_AUTH_ON_UPLOADS=false
